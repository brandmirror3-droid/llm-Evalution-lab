# ==============================================================================
# LLM Evaluation Lab — Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT SENSITIVE VALUES OR .env FILES TO VERSION CONTROL.
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Core Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change_me_to_a_secure_random_string_in_production_at_least_32_chars

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Security & CORS
# JSON-encoded array of allowed origins for development / production
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Foundation
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# If left empty or PostgreSQL is unreachable, the lab boots in degraded mode
# and honestly surfaces "Database: Not connected / Awaiting setup" in the UI.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_eval_lab
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Model Providers (Phase 2+ Readiness - Leave empty for Phase 1)
# The Phase 1 Overview and Status probes will inspect these and report
# "Not configured" or "Configured" without making live external API calls.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
